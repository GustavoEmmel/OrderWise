{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "check-db": "docker exec orderwise-postgres pg_isready -U youruser",
    "wait-for-db": "bash -c 'until docker exec orderwise-postgres pg_isready -U youruser; do echo \"Waiting for the database...\"; sleep 2; done;'",
    "dev": "npm run docker:up && npm run wait-for-db && ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "npm run docker:up && node dist/index.js",
    "build": "tsc",
    "test": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "openai": "^4.77.4",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
